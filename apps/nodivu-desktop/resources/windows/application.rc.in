#include <windows.h>
1 ICON "@CMAKE_CURRENT_BINARY_DIR@/nodivu.ico"
VS_VERSION_INFO VERSIONINFO
 FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904b0"
  BEGIN
   VALUE "CompanyName", "Nodivu contributors\0"
   VALUE "FileDescription", "Nodivu - Audio Studio\0"
   VALUE "FileVersion", "@NODIVU_APP_VERSION@\0"
   VALUE "InternalName", "nodivu\0"
   VALUE "LegalCopyright", "Nodivu contributors - MIT\0"
   VALUE "OriginalFilename", "nodivu.exe\0"
   VALUE "ProductName", "Nodivu\0"
   VALUE "ProductVersion", "@NODIVU_APP_VERSION@\0"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x409, 1200
 END
END
