{
  "name": "nodivu-electron",
  "version": "0.2.1-dev.2",
  "private": true,
  "description": "Canvas local de áudio Nodivu com motor Rust",
  "main": "main.cjs",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "smoke": "electron . --smoke-test",
    "test:audio": "electron . --smoke-test --test-audio",
    "package": "node package.cjs",
    "dev:ui": "electron . --frontend-demo",
    "test:ui": "node --test tests/demo-engine.test.cjs tests/playback-state.test.cjs tests/recents.test.cjs tests/virtual-cable.test.cjs",
    "dist": "electron-builder --config ../../scripts/release/config.cjs --win nsis --x64 --publish never"
  },
  "devDependencies": {
    "electron": "44.2.0",
    "electron-builder": "26.15.3"
  },
  "license": "MIT",
  "dependencies": {
    "dompurify": "3.4.16",
    "electron-updater": "6.8.9",
    "marked": "18.1.0",
    "tuf-js": "5.0.1",
    "yauzl": "3.4.0"
  },
  "author": "Nodivu contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/Warier/nodivu.git"
  }
}
