{
  "name": "nodivu-electron",
  "version": "0.1.2",
  "private": true,
  "description": "Canvas local de áudio Nodivu com motor Rust",
  "main": "main.cjs",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "smoke": "electron . --smoke-test",
    "test:audio": "electron . --smoke-test --test-audio",
    "package": "node package.cjs",
    "dev:ui": "electron . --frontend-demo",
    "test:ui": "node --test tests/demo-engine.test.cjs tests/playback-state.test.cjs tests/recents.test.cjs tests/virtual-cable.test.cjs"
  },
  "devDependencies": {
    "electron": "44.2.0"
  },
  "license": "MIT"
}
