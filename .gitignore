# Public source allowlist. New top-level folders require an explicit decision.
/*
!/.gitignore
!/.gitattributes
!/.editorconfig
!/README.md
!/LICENSE
!/THIRD-PARTY-NOTICES.md
!/Cargo.toml
!/Cargo.lock
!/rust-toolchain.toml
!/apps/
/apps/*
!/apps/nodivu-electron/
!/crates/
!/plugins/
!/examples/
!/scripts/
!/third_party/

# Dependencies, output, profiles, local media and editor state are never source.
**/node_modules/
**/target/
**/.local/
**/.tools/
**/__pycache__/
**/.idea/
**/.vscode/
*.pyc
*.log
*.tmp
*.user
*.exe
*.dll
*.clap
*.obj
*.lib
*.exp
*.pdb
*.mp3
*.wav
*.m4a
*.nodivu.json
.env
.env.*
*.pem
*.pfx

# Historical/private material is deliberately absent from the public tree.
/docs/
/installer/
/Projetos/
/tools/
/crates/nodivu-cli/
