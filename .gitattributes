# Match .editorconfig independently of the user's core.autocrlf setting.
* text=auto eol=lf
*.rs text eol=lf
*.js text eol=lf
*.cjs text eol=lf
*.mjs text eol=lf
*.json text eol=lf
*.md text eol=lf
*.toml text eol=lf
*.ps1 text eol=crlf
*.cpp text eol=lf
*.h text eol=lf
*.c text eol=lf
*.png binary
*.ico binary

# Preserve audited upstream bytes and its original whitespace.
third_party/** -text -whitespace
third_party/rnnoise-0.2/** -text -whitespace
third_party/qt-6.12.0-licenses/** -text
